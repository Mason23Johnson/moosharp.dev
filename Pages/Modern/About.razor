@page "/about"
@layout MainLayout
@inject IJSRuntime JS

<div class="scroll-deck">
    <section class="deck-slide slide-stack">
        <div class="stack-hover-wrapper">
            <div class="stack-mobile-tabs">
                <button type="button" class="stack-tab @(activeStackPanel == "stack" ? "active" : "")" @onclick='() => SetStackPanel("stack")'>Stack</button>
                <button type="button" class="stack-tab @(activeStackPanel == "brand" ? "active" : "")" @onclick='() => SetStackPanel("brand")'>Brand</button>
            </div>

            <div class="hover-zone hover-left-zone"></div>
            <div class="hover-zone hover-center-zone"></div>
            <div class="hover-zone hover-right-zone"></div>

            <div class="stack-interactive stack-mode-@activeStackPanel">
                <div class="side stack-side">
                    <h1 class="side-title">Stack</h1>
                    <p class="side-content">
                        C#, Java, JavaScript, CSS, HTML, Docker, NAS, Linux, Blazor, Entity Framework Core, ASP.NET &
                        More.
                    </p>
                </div>

                <div class="pc-center">
                    <img src="images/retroPC.png" class="pc-photo" alt="Retro PC" />
                </div>

                <div class="side brand-side">
                    <h1 class="side-title">Brand</h1>
                    <p class="side-content">
                        MooSharp is my personal brand, portfolio, and company.<br />
                        Moo is my nickname from childhood, and Sharp represents my focus on C#.
                    </p>
                </div>
            </div>
        </div>

        <div class="scroll-down-indicator">
            <span>V</span>
        </div>
    </section>

    <section class="deck-slide slide-personal explorer-layout visible">
        <div class="explorer-shell">
            <aside class="explorer-sidebar">
                <h3>Quick Access</h3>
                <ul>
                    <li @onclick="@(() => ToggleFolder("hdrive"))" class="@(openFolder == "hdrive" ? "active" : "")">
                        H: MooVault
                    </li>
                    <li @onclick="@(() => ToggleFolder("personal"))" class="@(openFolder == "personal" ? "active" : "")">
                        G: Personal
                    </li>
                </ul>
            </aside>

            <section class="explorer-main">
                <div class="explorer-toolbar">
                    <div class="explorer-breadcrumb">
                        <button type="button" class="crumb-button" @onclick="NavigateToExplorerRoot">Quick Access</button>
                        <span>/</span>
                        <button type="button" class="crumb-button" @onclick="NavigateToFolderRoot">@CurrentFolderName</button>
                        @if (!string.IsNullOrEmpty(subFolder))
                        {
                            <span>/</span>
                            <span class="crumb-current">@CurrentSubfolderName</span>
                        }
                    </div>
                </div>

                <div class="folder-grid">
                    @foreach (var entry in CurrentEntries)
                    {
                        <button type="button" class="folder-tile @(entry.Kind)" @onclick="@(() => ActivateEntry(entry))">
                            <div class="folder-tab"></div>
                            <div class="folder-face">
                                <img src="@entry.Icon" alt="" />
                                <div class="folder-copy">
                                    <span>@entry.Title</span>
                                    <small>@entry.Description</small>
                                </div>
                            </div>
                        </button>
                    }
                </div>
            </section>
        </div>

        @for (var i = 0; i < openWindows.Count; i++)
        {
            var windowId = openWindows[i];
            <div class="explorer-window"
                 style="top:@(120 + (i * 26))px; left:@(110 + (i * 28))px;">
                <div class="window-header" onmousedown="beginDrag(event, this.closest('.explorer-window'))">
                    <div class="window-title-group">
                        <span class="window-title">@GetWindowTitle(windowId)</span>
                        <span class="window-subtitle">@GetWindowSubtitle(windowId)</span>
                    </div>
                    <button @onclick="@(() => CloseWindow(windowId))">Close</button>
                </div>
                <div class="window-body">
                    @switch (windowId)
                    {
                        case "fullResume":
                            <div class="window-copy">
                                <p>Full resume available on request through the contact page.</p>
                                <p>Highlights: Salesforce development, full-stack Blazor work, backend systems, and indie game experiments.</p>
                            </div>
                            break;
                        case "projExp":
                            <div class="window-copy">
                                <p>Tinek App - AI Integration, AI Building, Data Analytics, Mobile Dev, Blazor Dev, DB, APIs, etc.</p>
                                <p>moosharp.dev - ...</p>
                                <p>salesforce internship - ...</p>
                                <p>Moosharp website building - ... redacted websites</p>
                            </div>
                            break;
                        case "skills":
                            <div class="window-copy">
                                <p>Salesforce: Apex, Visualforce, Lightning, SOQL, flows, integrations.</p>
                                <p>Full stack: C#, JS, HTML5, CSS, ASP.NET, Blazor, SQLite, EF Core.</p>
                                <p>Platform: Linux, Windows, Docker, NAS, Git, Azure DevOps.</p>
                            </div>
                            break;
                        case "marriageTxt":
                            <div class="window-copy">
                                <p>Married in 2024 and honeymooned in the Virgin Islands.</p>
                            </div>
                            break;
                        case "marriagePng":
                            <img src="images/wedding.png" class="window-image" alt="Wedding" />
                            break;
                        case "hobbiesTxt":
                            <div class="window-copy">
                                <p>Outside of software, I enjoy fishing, golf, pickleball, games, woodworking, and developing ideas into real things.</p>
                            </div>
                            break;
                        case "fish":
                            <img src="images/fishing.png" class="window-image" alt="Fishing" />
                            break;
                        case "pickle":
                            <img src="images/pickleball.png" class="window-image" alt="Pickleball" />
                            break;
                        case "golf":
                            <img src="images/golfing.png" class="window-image" alt="Golfing" />
                            break;
                    }
                </div>
            </div>
        }
    </section>
</div>

@code {
    private string? openFolder = "hdrive";
    private string? subFolder;
    private string activeStackPanel = "center";
    private readonly List<string> openWindows = new();

    private readonly List<ExplorerEntry> hDriveRoot = new()
    {
        new("fullResume", "Resume_Full.txt", "Full resume overview and core background.", "file", "icons/txt-icon.png"),
        new("resumeParts", "Resume_Parts", "Project experience and skills breakdown.", "folder", "icons/folder-icon.png")
    };

    private readonly List<ExplorerEntry> resumeParts = new()
    {
        new("projExp", "ProjectExp.txt", "Apps, tools, games, and shipped experiments.", "file", "icons/txt-icon.png"),
        new("skills", "Skills.txt", "Languages, platforms, tooling, and Salesforce specialties.", "file", "icons/txt-icon.png")
    };

    private readonly List<ExplorerEntry> personalRoot = new()
    {
        new("marriage", "Marriage", "Photos and life update folder.", "folder", "icons/folder-icon.png"),
        new("hobbies", "Hobbies", "Fishing, golf, pickleball, and more.", "folder", "icons/folder-icon.png")
    };

    private readonly List<ExplorerEntry> marriageFolder = new()
    {
        new("marriageTxt", "marriage.txt", "A quick note about 2024 and the honeymoon trip.", "file", "icons/txt-icon.png"),
        new("marriagePng", "wedding.png", "One of my favorite photos from the day.", "file", "icons/image-icon.png")
    };

    private readonly List<ExplorerEntry> hobbiesFolder = new()
    {
        new("hobbiesTxt", "hobbies.txt", "How I spend time away from work.", "file", "icons/txt-icon.png"),
        new("fish", "fishing.png", "Water, gear, quiet mornings, and a good catch.", "file", "icons/image-icon.png"),
        new("pickle", "pickleball.png", "Fast pace and just enough competition.", "file", "icons/image-icon.png"),
        new("golf", "golfing.png", "A lot of walking, a little chaos, and a great reset.", "file", "icons/image-icon.png")
    };

    private IEnumerable<ExplorerEntry> CurrentEntries =>
        (openFolder, subFolder) switch
        {
            ("hdrive", "resumeParts") => resumeParts,
            ("hdrive", _) => hDriveRoot,
            ("personal", "marriage") => marriageFolder,
            ("personal", "hobbies") => hobbiesFolder,
            ("personal", _) => personalRoot,
            _ => hDriveRoot
        };

    private string CurrentFolderName => openFolder == "personal" ? "G: Personal" : "H: MooVault";

    private string CurrentSubfolderName => subFolder switch
    {
        "resumeParts" => "Resume Parts",
        "marriage" => "Marriage",
        "hobbies" => "Hobbies",
        _ => string.Empty
    };

    private void ToggleFolder(string id)
    {
        openFolder = id;
        subFolder = null;
    }

    private void SetStackPanel(string panel)
    {
        activeStackPanel = activeStackPanel == panel ? "center" : panel;
    }

    private void NavigateToExplorerRoot()
    {
        openFolder = "hdrive";
        subFolder = null;
    }

    private void NavigateToFolderRoot()
    {
        subFolder = null;
    }

    private void ActivateEntry(ExplorerEntry entry)
    {
        if (entry.Kind == "folder")
        {
            subFolder = entry.Id;
            return;
        }

        OpenWindow(entry.Id);
    }

    private void OpenWindow(string id)
    {
        if (!openWindows.Contains(id))
        {
            openWindows.Add(id);
        }
    }

    private void CloseWindow(string id)
    {
        openWindows.Remove(id);
    }

    private string GetWindowTitle(string id) => id switch
    {
        "fullResume" => "Resume_Full.txt",
        "projExp" => "ProjectExp.txt",
        "skills" => "Skills.txt",
        "marriageTxt" => "marriage.txt",
        "marriagePng" => "wedding.png",
        "hobbiesTxt" => "hobbies.txt",
        "fish" => "fishing.png",
        "pickle" => "pickleball.png",
        "golf" => "golfing.png",
        _ => id
    };

    private string GetWindowSubtitle(string id) => id switch
    {
        "fullResume" => "Professional overview",
        "projExp" => "Project archive",
        "skills" => "Technical stack",
        "marriageTxt" => "Personal note",
        "marriagePng" => "Photo viewer",
        "hobbiesTxt" => "Lifestyle note",
        "fish" => "Photo viewer",
        "pickle" => "Photo viewer",
        "golf" => "Photo viewer",
        _ => "Explorer window"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await JS.InvokeVoidAsync("eval", @"
const observer = new IntersectionObserver(entries => {
entries.forEach(entry => {
if (entry.isIntersecting && !entry.target.classList.contains('visible')) {
entry.target.classList.add('visible');
observer.unobserve(entry.target);
}
});
}, { threshold: 0.2 });

document.querySelectorAll('.deck-slide').forEach(sec => observer.observe(sec));
");
    }

    private sealed record ExplorerEntry(string Id, string Title, string Description, string Kind, string Icon);
}
