@page "/about"
@layout MainLayout
@inject IJSRuntime JS

<div class="scroll-deck">
    <section class="deck-slide slide-stack">
        <div class="stack-hover-wrapper">
            <div class="stack-mobile-tabs">
                <button type="button" class="stack-tab @(activeStackPanel == "stack" ? "active" : "")"
                        @onclick='() => SetStackPanel("stack")'>Stack</button>
                <button type="button" class="stack-tab @(activeStackPanel == "brand" ? "active" : "")"
                        @onclick='() => SetStackPanel("brand")'>Brand</button>
            </div>

            <div class="hover-zone hover-left-zone"></div>
            <div class="hover-zone hover-center-zone"></div>
            <div class="hover-zone hover-right-zone"></div>

            <div class="stack-interactive stack-mode-@activeStackPanel">
                <div class="side stack-side">
                    <h1 class="side-title">Stack</h1>
                    <p class="side-content">
                        C#, Java, JavaScript, CSS, HTML, Docker, NAS, Linux, Blazor, Entity Framework Core, ASP.NET &
                        More.
                    </p>
                </div>

                <div class="pc-center">
                    <img src="images/retroPC.png" class="pc-photo" alt="Retro PC" />
                </div>

                <div class="side brand-side">
                    <h1 class="side-title">Brand</h1>
                    <p class="side-content">
                        MooSharp is my personal brand, portfolio, and company.<br />
                        Moo is my nickname from childhood, and Sharp represents my focus on C#.
                    </p>
                </div>
            </div>
        </div>

        <div class="scroll-down-indicator">
            <span>V</span>
        </div>
    </section>

    <section class="deck-slide slide-experience visible">
        <div class="experience-shell">
            <div class="experience-head">
                <div class="experience-kicker">Experience</div>
                <h2 class="experience-heading">Four chapters, so far.</h2>
                <p class="experience-intro">
                    School, a Salesforce internship, a product of my own, and client work.
                    Pick a chapter or turn the page.
                </p>
            </div>

            <div class="timeline">
                <div class="timeline-rail" aria-hidden="true"></div>

                @foreach (var chapter in chapters)
                {
                    <div class="timeline-item @(selectedChapterId == chapter.Id ? "open" : "")">
                        <button type="button" class="timeline-header" @onclick="@(() => ToggleChapter(chapter.Id))"
                                aria-expanded="@(selectedChapterId == chapter.Id ? "true" : "false")">
                            <span class="timeline-node">
                                <span class="timeline-index">@chapter.Numeral</span>
                            </span>
                            <span class="timeline-heading">
                                <span class="timeline-title">@chapter.Title</span>
                                <span class="timeline-org">@chapter.Org</span>
                            </span>
                            <span class="timeline-dates">@chapter.Dates</span>
                            <span class="timeline-chevron" aria-hidden="true"></span>
                        </button>

                        <div class="timeline-panel">
                            <div class="timeline-panel-inner">
                                <p class="timeline-lede">@chapter.Lede</p>

                                <h4 class="timeline-notes-head">@chapter.NotesHeading</h4>
                                <ul class="timeline-notes">
                                    @foreach (var note in chapter.Notes)
                                    {
                                        <li>@note</li>
                                    }
                                </ul>

                                <div class="timeline-tags">
                                    @foreach (var tag in chapter.Focus)
                                    {
                                        <span>@tag</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
</div>

@code {
    private string activeStackPanel = "center";
    private string selectedChapterId = string.Empty;

    private readonly List<Chapter> chapters = new()
    {
        new(
            "tinek",
            "01",
            "TINEK",
            "Founder and Software Engineer",
            "TINEK - tinek.us",
            "April 2026 - Present",
            "A mobile-first hunting prediction and property-mapping platform. My own product, and my own problem when it breaks.",
            "What I built",
            new[]
            {
                "Designed and built the app mobile-first on C#, Blazor, ASP.NET, JavaScript, SQL, and Leaflet.",
                "Interactive maps for properties, stands, cameras, and trails.",
                "Weather API integrations feeding the hunting scores and predictions.",
                "Database-backed property, mapping, and user features.",
                "Led the architecture, UI, testing, and deployment myself."
            },
            new[] { "Blazor", "Leaflet", "APIs", "Product" }),
        new(
            "education",
            "02",
            "Education",
            "University of Oklahoma",
            "Software Development and Integration",
            "Expected May 2027",
            "Software development and integration: writing the software, then making it work with the systems already running around it.",
            "Coursework",
            new[]
            {
                "Data structures, algorithms, and the design patterns that keep showing up in every project I build.",
                "Full-stack coursework across C#, Java, JavaScript, and SQL.",
                "The integration half: REST and SOAP APIs, databases, and getting separate systems to agree on the same data.",
                "Dean's Honor Roll. Former treasurer of the Central Oklahoma AISES chapter and the Chickasaw Nation CNRR program."
            },
            new[] { "Foundations", "Integration", "Full Stack", "APIs" }),
        new(
            "americanfidelity",
            "03",
            "American Fidelity",
            "Salesforce Developer Intern",
            "American Fidelity - Oklahoma City, OK",
            "August 2025 - Present",
            "Platform work on a live org, inside an Agile team, where whatever I shipped had to hold up for people who depended on it.",
            "On the job",
            new[]
            {
                "Built Salesforce features with Apex, SOQL, Visualforce, and Lightning components.",
                "Wired up REST and SOAP integrations to external business systems.",
                "Configured flows, objects, reports, and validation rules.",
                "Diagnosed and fixed platform issues inside Agile sprints.",
                "Wrote and ran the tests that made deployments safe to push."
            },
            new[] { "Apex", "SOQL", "Integrations", "Agile" }),
        new(
            "moosharp",
            "04",
            "MooSharp",
            "MooSharp",
            "Portfolio and client websites - moosharp.dev",
            "Ongoing",
            "The brand, the portfolio, and the shop. This site is the sample; the client work stays unnamed.",
            "The work",
            new[]
            {
                "Built this portfolio in Blazor, Razor, JavaScript, HTML, and CSS.",
                "Reusable project cards, interactive animations, and a desktop-inspired project interface.",
                "Company sites with real design direction, not a template with the colors swapped.",
                "Branding, build, revisions, and client back-and-forth until it is finished."
            },
            new[] { "Blazor", "Razor", "UI Systems", "Client Work" })
    };

    private void ToggleChapter(string id)
    {
        selectedChapterId = selectedChapterId == id ? string.Empty : id;
    }

    private void SetStackPanel(string panel)
    {
        activeStackPanel = activeStackPanel == panel ? "center" : panel;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await JS.InvokeVoidAsync("eval", @"
const observer = new IntersectionObserver(entries => {
entries.forEach(entry => {
if (entry.isIntersecting && !entry.target.classList.contains('visible')) {
entry.target.classList.add('visible');
observer.unobserve(entry.target);
}
});
}, { threshold: 0.2 });

document.querySelectorAll('.deck-slide').forEach(sec => observer.observe(sec));
");
    }

    private sealed record Chapter(
        string Id,
        string Numeral,
        string TabLabel,
        string Title,
        string Org,
        string Dates,
        string Lede,
        string NotesHeading,
        string[] Notes,
        string[] Focus);
}
