@page "/about"
@layout MainLayout
@inject IJSRuntime JS

<div class="scroll-deck">
    <section class="deck-slide slide-stack">
        <div class="stack-hover-wrapper">
            <div class="stack-mobile-tabs">
                <button type="button" class="stack-tab @(activeStackPanel == "stack" ? "active" : "")"
                        @onclick='() => SetStackPanel("stack")'>Stack</button>
                <button type="button" class="stack-tab @(activeStackPanel == "brand" ? "active" : "")"
                        @onclick='() => SetStackPanel("brand")'>Brand</button>
            </div>

            <div class="hover-zone hover-left-zone"></div>
            <div class="hover-zone hover-center-zone"></div>
            <div class="hover-zone hover-right-zone"></div>

            <div class="stack-interactive stack-mode-@activeStackPanel">
                <div class="side stack-side">
                    <h1 class="side-title">Stack</h1>
                    <p class="side-content">
                        C#, Java, JavaScript, CSS, HTML, Docker, NAS, Linux, Blazor, Entity Framework Core, ASP.NET &
                        More.
                    </p>
                </div>

                <div class="pc-center">
                    <img src="images/retroPC.png" class="pc-photo" alt="Retro PC" />
                </div>

                <div class="side brand-side">
                    <h1 class="side-title">Brand</h1>
                    <p class="side-content">
                        MooSharp is my personal brand, portfolio, and company.<br />
                        Moo is my nickname from childhood, and Sharp represents my focus on C#.
                    </p>
                </div>
            </div>
        </div>

        <div class="scroll-down-indicator">
            <span>V</span>
        </div>
    </section>

    <section class="deck-slide slide-experience visible">
        <div class="experience-shell">
            <div class="experience-head">
                <div class="experience-kicker">Experience</div>
                <h2 class="experience-heading">A live view of the work behind MooSharp.</h2>
                <p class="experience-intro">
                    Education laid the foundation, the internship sharpened execution, and the company work turned that
                    into products,
                    systems, and branded websites that had to hold up outside a classroom.
                </p>
            </div>

            <div class="experience-frame">
                <nav class="experience-rail" aria-label="Experience navigation">
                    @foreach (var entry in experienceEntries)
                    {
                        <button type="button" class="experience-node @(selectedExperienceId == entry.Id ? "active" : "")"
                                @onclick="@(() => SetExperience(entry.Id))">
                            <span class="experience-index">@entry.Index</span>
                            <span class="experience-node-copy">
                                <strong>@entry.Title</strong>
                                <small>@entry.Subtitle</small>
                            </span>
                        </button>
                    }
                </nav>

                <section class="experience-stage">
                    <div class="experience-stage-top">
                        <span class="experience-stage-kicker">@SelectedExperience.StageLabel</span>
                        <span class="experience-stage-rule"></span>
                        <span class="experience-stage-subtitle">@SelectedExperience.Subtitle</span>
                    </div>

                    <h3 class="experience-stage-title">@SelectedExperience.Title</h3>
                    <p class="experience-stage-copy">@SelectedExperience.Overview</p>

                    <div class="experience-signal-row">
                        @foreach (var focus in SelectedExperience.FocusAreas)
                        {
                            <span class="experience-signal">@focus</span>
                        }
                    </div>

                    <div class="experience-detail-lines">
                        @foreach (var detail in SelectedExperience.Details)
                        {
                            <p>@detail</p>
                        }
                    </div>

                    <div class="experience-focus-strip">
                        <span class="experience-focus-label">Focus</span>
                        <div class="experience-focus-items">
                            @foreach (var focus in SelectedExperience.FocusAreas)
                            {
                                <span>@focus</span>
                            }
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </section>
</div>

@code {
    private string activeStackPanel = "center";
    private string selectedExperienceId = "education";

    private readonly List<ExperienceEntry> experienceEntries = new()
    {
        new(
            "education",
            "01",
            "Education",
            "UCO",
            "Student",
            "Education directed towards not just development, but software engineering, systems thinking, and problem-solving for applications and companies.",
            new[]
            {
                "Data structures, algorithms, and software engineering principles that could be applied in real-world contexts.",
                "Full-stack development experience across multiple languages, frameworks, and project types, with a focus on clean code and maintainable systems.",
                "Mathematics, logic, and problem-solving skills that could be applied to complex technical challenges and product design questions."
            },
            new[] { "Foundations", "Problem Solving", "Full Stack", "Systems" }),
        new(
            "internship",
            "02",
            "Salesforce Internship",
            "Platform Delivery",
            "Producer",
            "Real delivery work inside business constraints, where clean implementation mattered as much as speed and communication.",
            new[]
            {
                "Worked through live Salesforce platform tasks involving flows, debugging, data handling, and feature delivery.",
                "Learned how to balance correctness, platform limitations, and stakeholder expectations in a production environment.",
                "Strengthened the habits around testing changes carefully, documenting decisions, and shipping inside an established stack."
            },
            new[] { "Salesforce", "Flows", "Apex", "Delivery" }),
        new(
            "tinek",
            "03",
            "Tinek",
            "Product Building",
            "Product",
            "An AI-driven hunting product that combines predictions, data workflows, application design, and long-term product thinking.",
            new[]
            {
                "Building the product around AI integration, analytics, storage, and app-first functionality across mobile and web.",
                "Using Blazor, APIs, and structured data flows to shape a usable tool instead of a one-off prototype.",
                "Treating the app as a living product roadmap with room for prediction systems, user data, and ongoing feature expansion."
            },
            new[] { "AI", "Blazor", "APIs", "Analytics" }),
        new(
            "moosharp",
            "04",
            "MooSharp Website Building",
            "Client Work",
            "Client",
            "Website building for companies under the MooSharp brand, focused on clean presentation, custom direction, and practical delivery.",
            new[]
            {
                "Built company websites with stronger visual direction, cleaner structure, and clearer communication than generic templates.",
                "Handled the mix of branding, development, iteration, and client-facing refinement needed to land a finished result.",
                "Used MooSharp as both the portfolio and the service layer for delivering redacted company website work."
            },
            new[] { "Branding", "Web Delivery", "Client Work", "UI Systems" })
    };

    private ExperienceEntry SelectedExperience => experienceEntries.First(entry => entry.Id == selectedExperienceId);

    private void SetStackPanel(string panel)
    {
        activeStackPanel = activeStackPanel == panel ? "center" : panel;
    }

    private void SetExperience(string id) => selectedExperienceId = id;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await JS.InvokeVoidAsync("eval", @"
const observer = new IntersectionObserver(entries => {
entries.forEach(entry => {
if (entry.isIntersecting && !entry.target.classList.contains('visible')) {
entry.target.classList.add('visible');
observer.unobserve(entry.target);
}
});
}, { threshold: 0.2 });

document.querySelectorAll('.deck-slide').forEach(sec => observer.observe(sec));
");
    }

    private sealed record ExperienceEntry(
        string Id,
        string Index,
        string Title,
        string Subtitle,
        string StageLabel,
        string Overview,
        string[] Details,
        string[] FocusAreas);
}
