    private static string StatusTone(string status) => status switch
    {
        "Live" or "Playable" or "Download" => "status-live",
        "Coming Soon" => "status-soon",
        _ => "status-info"
    };

    private static string PreviewHost(string url)
    {
        var host = new Uri(url).Host;
        return host.StartsWith("www.") ? host[4..] : host;
    }

    private sealed record ProjectItem(
        string Title,
        string Summary,
        string? Thumbnail,
        string? ProjectUrl,
        string Status,
        string Platform,
        string[] Tags,
        string DeepDescription,
        string BuildNotes,
        bool IsDownload = false,
        bool IsExternal = false,
        string? GithubUrl = null,
        bool IsPreview = false);
}
