@page "/projects"
@layout MainLayout

<section class="projects-page">
    <header class="projects-hero">
        <div class="projects-hero-copy projects-hero-single">
            <p class="projects-kicker">MooSharp Projects</p>
            <h1>Product builds, experiments, and launch targets.</h1>
            <p class="projects-summary">
                This is the current slate: shipping tools, game work, and the next major build on deck.
                The roadmap is focused on prediction systems, polished tooling, and the next release wave planned for Deer Season 2026.
            </p>
            <div class="projects-badges">
                <span>AI</span>
                <span>Mobile + Web</span>
                <span>Blazor + C#</span>
                <span>Indie Systems</span>
            </div>
        </div>
    </header>

    <section class="projects-feature">
        <div class="feature-art">
            <img src="/images/projects/tinek.png" alt="Tinek" />
        </div>
        <div class="feature-copy">
            <p class="projects-kicker">Roadmap Lead</p>
            <h2>Tinek</h2>
            <p>
                Tinek is being built as a hunting prediction platform powered by AI models and mathematical logic.
                The plan is to combine smart forecasts, field data storage, scouting notes, and long-term utility in
                one system that works on both mobile and web.
            </p>
            <div class="feature-meta">
                <span class="chip">Coming Soon</span>
                <span class="chip">Prediction Engine</span>
                <span class="chip">Data Storage</span>
                <span class="chip">Field Utility</span>
            </div>
        </div>
    </section>

    <section class="uploads-grid">
        @foreach (var item in Items)
        {
            <article class="upload-card">
                <div class="upload-thumb">
                    <img src="@item.Thumbnail" alt="@item.Title" />
                    <span class="upload-status">@item.Status</span>
                </div>
                <div class="upload-body">
                    <div class="upload-heading">
                        <h4>@item.Title</h4>
                        <span class="upload-platform">@item.Platform</span>
                    </div>
                    <p>@item.Summary</p>
                    <div class="upload-tags">
                        @foreach (var tag in item.Tags)
                        {
                            <span>@tag</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(item.ProjectUrl))
                    {
                        <a class="upload-link" href="@item.ProjectUrl">Open</a>
                    }
                    else
                    {
                        <span class="upload-link disabled">Coming Soon</span>
                    }
                </div>
                <div class="upload-hover-panel">
                    <p class="hover-kicker">Deeper Look</p>
                    <h5>@item.Title</h5>
                    <p>@item.DeepDescription</p>
                    <p class="hover-build">@item.BuildNotes</p>
                </div>
            </article>
        }
    </section>

</section>

@code {
    private readonly List<ProjectItem> Items = new()
    {
        new(
            "Moochine Arcade",
            "A growing hub for prototypes, arcade experiments, and game concepts.",
            "/images/projects/MoochineArcade.png",
            "/arcade",
            "Playable",
            "Web",
            new[] { "Arcade", "Prototype Lab", "Games" },
            "Moochine Arcade is the testing ground for quick ideas, playable prototypes, and game concepts that can grow into bigger projects over time.",
            "Built with a mix of Blazor, JavaScript, lightweight game logic, and a storefront-style shell that makes the collection feel more intentional than a loose page of links."),
        new(
            "MooCastScoreboard",
            "Livestream scoreboard editor for sports streams and quick game-day overlays.",
            "/images/projects/MooCast.png",
            "/MooCast",
            "Live",
            "Web",
            new[] { "Scoreboard", "Streaming", "Utility" },
            "MooCastScoreboard is meant to be a practical streamer utility: update scores fast, switch sports, adjust team styling, and keep the overlay readable under pressure.",
            "It is being built as a focused Blazor tool with sport-aware controls, editable team branding, and a live preview so streamers can tune the layout before it goes on-screen."),
        new(
            "Tritactic",
            "Tactical board-game concept still in active development.",
            "/images/projects/TriTactic.png",
            "/games/tri-tactic",
            "Playable Prototype",
            "Web",
            new[] { "Strategy", "Board Game", "Prototype" },
            "Tri-Tactic is a memory-based twist on tic-tac-toe where pieces cycle off the board, which adds tempo, pressure, and more room for actual strategy.",
            "The current build uses a C# game engine with Blazor UI, keyboard input support, and computer-turn logic that now runs more reliably inside the app.")
    };

    private sealed record ProjectItem(
        string Title,
        string Summary,
        string Thumbnail,
        string? ProjectUrl,
        string Status,
        string Platform,
        string[] Tags,
        string DeepDescription,
        string BuildNotes);
}
