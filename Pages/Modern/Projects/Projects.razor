@page "/projects"
@layout MainLayout

<div class="projects-container">
    <h1 class="glitch-header">Projects</h1>
    <p class="projects-intro">
        
    </p>

    <div class="product-grid">
        <div class="product-card">
            <h3>MooDo Task Scheduler</h3>
            <p>A full-stack task/calendar system with notifications, user auth, and EF Core models.</p>
            <div class="card-buttons">
                <a href="moosharp.dev/MooDo" target="_blank">Try Front-End Demo</a>
                <a href="https://github.com/MooSharp/BlazorScheduler" target="_blank">View Code</a>
            </div>
        </div>

        <div class="product-card">
            <h3>MooCast Streaming Sports Scoreboard</h3>
            <p>A growing scoreboard used by streamers for sports coverage.</p>
            <div class="card-buttons">
                <a href="/scoreboard">Use Scoreboard</a>
            </div>
        </div>

        <div class="product-card card-games-link">
            <h3>The Moochine Arcade</h3>
            <p>Jump into my indie game prototypes, experiments, and builds.</p>
            <div class="card-buttons">
                <a href="/games">Enter Arcade</a>
            </div>
        </div>
    </div>
</div>
