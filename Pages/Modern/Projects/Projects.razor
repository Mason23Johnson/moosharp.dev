@page "/projects"
@layout MainLayout

<section class="projects-page">
    <header class="projects-hero">
        <p class="projects-kicker">MooSharp</p>
        <h1 class="projects-page-title">Projects</h1>
        <div class="projects-title-rule"></div>
    </header>

    <section class="projects-feature">
        <div class="feature-art">
            <img src="/images/projects/tinek.png" alt="Tinek" />
        </div>
        <div class="feature-copy">
            <p class="projects-kicker">Roadmap Lead</p>
            <h2>Tinek</h2>
            <p>
                Tinek is being built as a hunting prediction platform powered by AI models and mathematical logic.
                The plan is to combine smart forecasts, field data storage, scouting notes, and long-term utility in
                one system that works on both mobile and web.
            </p>
            <ul class="tag-list">
                <li>Prediction Engine</li>
                <li>Data Storage</li>
                <li>Field Utility</li>
            </ul>
            <div class="feature-footer">
                <span class="status-label status-live"><span class="status-dot"></span>Out Now</span>
                <a class="card-action primary" href="https://tinek.us" target="_blank" rel="noopener noreferrer">
                    Visit tinek.us <span class="arrow arrow-out" aria-hidden="true">↗</span>
                </a>
            </div>
        </div>
    </section>

    <section class="uploads-grid">
        @foreach (var item in Items)
        {
            <article class="upload-card">
                <div class="upload-main">
                    <div class="upload-thumb @(item.IsPreview ? "is-preview" : null)">
                        @if (item.IsPreview && !string.IsNullOrEmpty(item.Thumbnail) && !string.IsNullOrEmpty(item.ProjectUrl))
                        {
                            <div class="preview-window">
                                <div class="preview-bar" aria-hidden="true">
                                    <span></span><span></span><span></span>
                                    <em>@PreviewHost(item.ProjectUrl)</em>
                                </div>
                                <img src="@item.Thumbnail" alt="@item.Title website preview" loading="lazy" />
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(item.Thumbnail))
                        {
                            <img src="@item.Thumbnail" alt="@item.Title" loading="lazy" />
                        }
                        else
                        {
                            <div class="upload-thumb-placeholder">
                                <span>@item.Platform</span>
                            </div>
                        }
                    </div>

                    <div class="upload-body">
                        <div class="upload-meta">
                            <span class="upload-platform">@item.Platform</span>
                            <span class="status-label @StatusTone(item.Status)"><span class="status-dot"></span>@item.Status</span>
                        </div>
                        <h3>@item.Title</h3>
                        <p>@item.Summary</p>
                        <ul class="tag-list">
                            @foreach (var tag in item.Tags)
                            {
                                <li>@tag</li>
                            }
                        </ul>
                    </div>

                    <div class="upload-reveal">
                        <p class="hover-kicker">Deeper Look</p>
                        <h4>@item.Title</h4>
                        <p>@item.DeepDescription</p>
                        <p class="hover-build">@item.BuildNotes</p>
                    </div>
                </div>

                <div class="upload-footer">
                    @if (!string.IsNullOrWhiteSpace(item.ProjectUrl))
                    {
                        @if (item.IsDownload)
                        {
                            <a class="card-action primary" href="@item.ProjectUrl" download>
                                Download <span class="arrow arrow-down" aria-hidden="true">↓</span>
                            </a>
                        }
                        else
                        {
                            <a class="card-action primary" href="@item.ProjectUrl" target="@(item.IsExternal ? "_blank" : null)" rel="@(item.IsExternal ? "noopener noreferrer" : null)">
                                @(item.IsExternal ? "Visit Site" : "Open")
                                <span class="arrow @(item.IsExternal ? "arrow-out" : "arrow-right")" aria-hidden="true">@(item.IsExternal ? "↗" : "→")</span>
                            </a>
                        }
                    }
                    else if (string.IsNullOrWhiteSpace(item.GithubUrl))
                    {
                        <span class="card-action disabled">Coming Soon</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.GithubUrl))
                    {
                        <a class="card-action" href="@item.GithubUrl" target="_blank" rel="noopener noreferrer">
                            GitHub <span class="arrow arrow-out" aria-hidden="true">↗</span>
                        </a>
                    }
                </div>
            </article>
        }
    </section>

</section>

