            LongDescription = "BeamRunners drops players into a high-speed arena where every move you make leaves a permanent glowing trail. The longer you survive, the more dangerous the grid becomes. Cut off opponents, force bad angles, and be the last one running. Built for fast competitive sessions with a clean neon aesthetic and tight multiplayer mechanics.",
            Tags = new() { "Multiplayer", "Arena", "PC", "Steam" },
            Icon = "/icons/folder-icon.png",
            Hero = "/images/moosharpbackgroundblack.jpg",
            HasSteam = true,
