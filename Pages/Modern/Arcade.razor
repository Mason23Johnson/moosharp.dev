@page "/arcade"
@layout MainLayout

<div class="games-container">
    <h1 class="glitch-header">Moochine Arcade</h1>
    <p class="games-intro">Some Godot, some C# and a whole lot of bugs.</p>

    <div class="arcade-grid">
        <div class="arcade-card">
            <h3>Quick Click</h3>
            <p>Click as many targets as you can before running out of time.</p>
            <a href="/arcade/quickclick">Play</a>
        </div>

        <div class="arcade-card">
            <h3>Tri-Tactic</h3>
            <p>3-piece infinite Tic-Tac-Toe with memory-based removal rules.</p>
            <a href="/arcade/tri-tactic">Play</a>
        </div>

        <div class="arcade-card">
            <h3>Loot & Launch</h3>
            <p>Pixel physics meets chaos. Loot gear and survive madness.</p>
            <a href="#">Preview</a>
        </div>
    </div>
</div>
