@page "/arcade"
@layout MainLayout
@inject IJSRuntime JS

<canvas id="gamesMatrixBackground"></canvas>

<section class="steam-arcade-page">
    <header class="store-topbar">
        <div>
            <p class="store-kicker">Moochine Arcade</p>
            <h1>Arcade library</h1>
        </div>
        <div class="store-pill">5 titles tracked</div>
    </header>

    <div class="steam-arcade">
        <aside class="steam-sidebar">
            <div class="sidebar-header">
                <span>Library</span>
                <span class="sidebar-count">@Games.Count</span>
            </div>
            <ul class="game-list">
                @foreach (var g in Games)
                {
                    <li class="game-item @(g == Selected ? "active" : "")" @onclick="() => Select(g)">
                        <img class="game-icon" src="@g.Icon" alt="" />
                        <div class="game-meta">
                            <span class="game-name">@g.Name</span>
                            <span class="game-tag">@g.Tagline</span>
                        </div>
                        <span class="game-state">@g.Status</span>
                    </li>
                }
            </ul>
        </aside>

        <section class="steam-detail">
            <div class="hero" style="background-image: url('@Selected.Hero');">
                <div class="hero-overlay"></div>
                <div class="hero-info">
                    <p class="store-kicker">@Selected.Badge</p>
                    <h2 class="hero-title">@Selected.Name</h2>
                    <p class="hero-desc">@Selected.Description</p>

                    <div class="detail-actions">
                        @if (Selected.CanPlay && !string.IsNullOrWhiteSpace(Selected.PlayUrl))
                        {
                            <a class="play-btn" target="_blank" href="@Selected.PlayUrl">Play Now</a>
                        }
                        else
                        {
                            <span class="play-btn disabled">Coming Soon</span>
                        }
                        @if (Selected.HasSteam)
                        {
                            @if (!string.IsNullOrWhiteSpace(Selected.SteamUrl))
                            {
                                <a class="steam-btn" href="@Selected.SteamUrl" target="_blank" rel="noopener noreferrer">Wishlist on Steam</a>
                            }
                            else
                            {
                                <span class="steam-btn disabled">Steam - Coming Soon</span>
                            }
                        }
                        <a class="visit-btn" href="/projects">Project Hub</a>
                    </div>

                    <div class="tags">
                        @foreach (var t in Selected.Tags)
                        {
                            <span class="tag">@t</span>
                        }
                    </div>
                </div>
            </div>

            <div class="detail-grid">
                <div class="detail-panel">
                    <p class="panel-kicker">About This Game</p>
                    <h3>@Selected.Tagline</h3>
                    <p>@Selected.LongDescription</p>
                </div>
                <div class="detail-panel">
                    <p class="panel-kicker">Game Data</p>
                    <ul class="detail-stats">
                        <li><span>Status</span><strong>@Selected.Status</strong></li>
                        <li><span>Platform</span><strong>@Selected.Platform</strong></li>
                        <li><span>Release</span><strong>@Selected.Release</strong></li>
                        <li><span>Build Focus</span><strong>@Selected.Focus</strong></li>
                    </ul>
                </div>
            </div>
        </section>
    </div>
</section>

@code {
