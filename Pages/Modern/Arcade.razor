            LongDescription = "21 Down is the furthest-out concept in the lineup, but it sets the tone for where Moochine Arcade wants to go next: bigger systems, stronger identity, and game ideas that can grow beyond quick browser sessions.",
            Tags = new() { "Action", "Godot", "Concept" },
            Icon = "/icons/godot.png",
            Hero = "/images/retroPC.png"
        }
    };

    private GameItem Selected = default!;

    protected override void OnInitialized()
    {
        Selected = Games.First();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("startGamesMatrix");
        }
    }

    private void Select(GameItem game) => Selected = game;

    private sealed class GameItem
    {
        public GameItem(string name, string? playUrl, bool canPlay)
        {
            Name = name;
            PlayUrl = playUrl;
            CanPlay = canPlay;
        }

        public string Name { get; set; }
        public string? PlayUrl { get; set; }
        public bool CanPlay { get; set; }
        public string Badge { get; set; } = "";
        public string Status { get; set; } = "";
        public string Release { get; set; } = "";
        public string Platform { get; set; } = "";
        public string Focus { get; set; } = "";
        public string Tagline { get; set; } = "";
        public string Description { get; set; } = "";
        public string LongDescription { get; set; } = "";
        public List<string> Tags { get; set; } = new();
        public string Icon { get; set; } = "/icons/folder-icon.png";
        public string Hero { get; set; } = "/images/moosharpbackground.jpg";
        public bool HasSteam { get; set; } = false;
        public string? SteamUrl { get; set; } = null;
    }
}
