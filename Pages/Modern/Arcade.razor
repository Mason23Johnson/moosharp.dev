            Focus = "Classic Gameplay",
            Tagline = "A familiar snake run wrapped in neon terminal energy.",
            Description = "Classic movement, modern skin, and a clean session-based score chase.",
            LongDescription = "Snake keeps the library grounded with something immediate and readable. It is a simple browser build with a retro feel, quick restart cycle, and a more polished presentation than the old-school original.",
