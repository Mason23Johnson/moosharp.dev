@page "/arcade/snake"
@layout MainLayout
@inject IJSRuntime JS

<link href="css/ArcadeCSS/snake.css" rel="stylesheet" />

<section class="snake-page">
    <div class="snake-wrap">
        <div class="snake-logo-wrap">
            <img src="/images/projects/snake.png" alt="Snake" class="snake-logo" />
        </div>

        <div class="snake-stage">
            <canvas id="snakeCanvas" width="576" height="576"></canvas>

            <div class="snake-hud">
                <div class="hud-left">
                    <div class="hud-line">
                        <span class="hud-label">Score</span>
                        <span id="snakeScore" class="hud-value">0</span>
                    </div>
                    <div class="hud-line">
                        <span class="hud-label">Best</span>
                        <span id="snakeBest" class="hud-value">0</span>
                    </div>
                </div>

                <div class="hud-right">
                    <button class="hud-btn primary" id="btnStart">Start</button>
                    <button class="hud-btn" id="btnPause">Pause</button>
                    <button class="hud-btn outline" id="btnRestart">Restart</button>
                    <select id="snakeSpeed" class="hud-select" title="Speed">
                        <option value="6">Speed: 6</option>
                        <option value="8" selected>Speed: 8</option>
                        <option value="10">Speed: 10</option>
                        <option value="12">Speed: 12</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="snake-help">
            Arrow or WASD to move. Press Start to begin, `P` to pause, and `R` to restart.
        </div>
    </div>
</section>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("snakeGame.init");
        }
    }
}
