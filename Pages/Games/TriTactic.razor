@page "/games/tri-tactic"
@using MooSharp.Pages.Games
@inject IJSRuntime JS
@implements IDisposable

<link href="css/ModernCSS/tritactic.css" rel="stylesheet" />

<section class="tri-page">
    <div class="tri-shell">
        <div class="tri-logo-wrap">
            <img src="/images/projects/TriTactic.png" alt="Tri-Tactic" class="tri-logo" />
        </div>

        <div class="tri-panel">
            <pre class="tri-output">@outputText</pre>

            @if (engine == null)
            {
                <div class="tri-actions">
                    <button type="button" class="tri-btn primary" @onclick="StartGame">Start Game</button>
                </div>
            }
            else if (engine.AwaitingSymbol)
            {
                <div class="tri-actions">
                    <button type="button" class="tri-btn" @onclick='() => SelectSymbol("X")'>Play as X</button>
                    <button type="button" class="tri-btn" @onclick='() => SelectSymbol("O")'>Play as O</button>
                </div>
            }
            else
            {
                <div class="tri-board-wrap">
                    <div class="game-grid-3 tri-grid">
                        @for (int i = 0; i < 9; i++)
                        {
                            var index = i;
                            <button type="button"
                                    class="tri-cell @(awaitingMove && string.IsNullOrEmpty(engine.Board[index]) ? "tri-cell-active" : "tri-cell-idle")"
                                    disabled="@(!awaitingMove || !string.IsNullOrEmpty(engine.Board[index]))"
                                    @onclick="@(() => Move(index))">
                                @GetCellLabel(index)
                            </button>
                        }
                    </div>
                </div>

                @if (engine.GameOver)
                {
                    <div class="tri-actions">
                        <button type="button" class="tri-btn primary" @onclick="RestartGame">Play Again</button>
                    </div>
                }
            }
        </div>

        <p class="tri-disclaimer">
            Disclaimer: this is a console game for your computer, not HTML. Written with only C#.
        </p>
    </div>
</section>

@code {
    private TriTacticEngine? engine;
    private string outputText = "";
    private bool awaitingMove;
    private DotNetObjectReference<TriTactic>? dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("addKeydownListener", dotNetRef);
        }
    }

    [JSInvokable]
    public void HandleKeyPress(string key)
    {
        if (awaitingMove && int.TryParse(key, out int slot) && slot >= 1 && slot <= 9)
        {
            Move(slot - 1);
        }
    }

    private void StartGame()
    {
        outputText = "";
        awaitingMove = false;
        engine = new TriTacticEngine(AppendOutput, PromptSymbol, PromptBoard);
        engine.Start();
        SyncOutput();
        awaitingMove = engine.IsPlayerTurn;
        StateHasChanged();
    }

    private void SelectSymbol(string symbol)
    {
        if (engine is null)
            return;

        var accepted = engine.ReceiveSymbol(symbol);
        if (accepted)
        {
            SyncOutput();
            awaitingMove = engine.IsPlayerTurn;
            StateHasChanged();
        }
    }

    private void AppendOutput(string text)
    {
        _ = InvokeAsync(() =>
        {
            SyncOutput();
            StateHasChanged();
        });
    }

    private void PromptSymbol()
    {
        _ = InvokeAsync(() =>
        {
            awaitingMove = false;
            StateHasChanged();
        });
    }

    private void PromptBoard()
    {
        _ = InvokeAsync(() =>
        {
            awaitingMove = engine?.IsPlayerTurn == true;
            SyncOutput();
            StateHasChanged();
        });
    }

    private void Move(int index)
    {
        if (engine is null)
            return;

        var accepted = engine.ReceiveMove(index);
        if (accepted)
        {
            SyncOutput();
            awaitingMove = engine.IsPlayerTurn;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void RestartGame()
    {
        StartGame();
    }

    public void Dispose()
    {
        dotNetRef?.Dispose();
    }

    private string GetCellLabel(int index)
    {
        if (engine is null)
            return (index + 1).ToString();

        return string.IsNullOrEmpty(engine.Board[index]) ? (index + 1).ToString() : engine.Board[index];
    }

    private void SyncOutput()
    {
        outputText = engine is null
            ? string.Empty
            : string.Join("\n", engine.LogLines);
    }
}
