@page "/arcade/quickclick"
@layout MainLayout
@inject IJSRuntime JS

<link href="css/ArcadeCSS/QuickClick.css" rel="stylesheet" />

<section class="qc-page">
    <div class="qc-shell">
        <div class="qc-logo-wrap">
            <img src="/images/projects/quickclick.png" alt="Quick Click" class="qc-logo" />
        </div>

        <div class="qc-stage">
            @if (gameOver)
            {
                <div class="qc-overlay">
                    <div class="qc-modal">
                        <h2>Game Over!</h2>
                        <p>You scored <strong>@score</strong> clicks.</p>
                        <div class="qc-modal-actions">
                            <button class="qc-btn" @onclick="StartGame">Play Again</button>
                            <button class="qc-btn ghost" @onclick="CopyScore">Copy Score</button>
                        </div>
                        @if (copyMessage is not null)
                        {
                            <p class="qc-info">@copyMessage</p>
                        }
                    </div>
                </div>
            }

            <div class="qc-topbar">
                <div class="qc-stat">
                    <span>Time Left</span>
                    <strong>@Math.Ceiling(timeLeft)s</strong>
                </div>
                <div class="qc-stat">
                    <span>Score</span>
                    <strong>@score</strong>
                </div>
            </div>

            @if (!gameStarted)
            {
                <div class="qc-start-panel">
                    <p>Click start when you are ready. The timer does not begin until you do.</p>
                    <button class="qc-btn" @onclick="StartGame">Start Game</button>
                </div>
            }
            else
            {
                <div class="qc-play-area" @onclick="OnMissClick">
                    <div class="qc-target" style="@targetStyle" @onclick:stopPropagation="true" @onclick="TargetClicked"></div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private bool gameStarted = false;
    private bool gameOver = false;
    private int score = 0;
    private double timeLeft = 30;
    private Timer? gameTimer;
    private string targetStyle = "";
    private string? copyMessage;
    private readonly Random rand = new();

    private void StartGame()
    {
        score = 0;
        timeLeft = 30;
        gameStarted = true;
        gameOver = false;
        copyMessage = null;
        MoveTarget();

        gameTimer?.Dispose();
        gameTimer = new Timer(UpdateGame, null, 0, 100);
    }

    private void UpdateGame(object? state)
    {
        InvokeAsync(() =>
        {
            timeLeft -= 0.1;

            if (timeLeft <= 0)
            {
                EndGame();
            }

            StateHasChanged();
        });
    }

    private async void EndGame()
    {
        gameTimer?.Dispose();
        gameOver = true;
        gameStarted = false;
        await Task.Delay(50);
        await InvokeAsync(StateHasChanged);
    }

    private void MoveTarget()
    {
        const int areaSize = 500;
        const int targetSize = 50;
        int max = areaSize - targetSize;

        int left = rand.Next(0, max);
        int top = rand.Next(0, max);
        targetStyle = $"left: {left}px; top: {top}px;";
    }

    private async Task TargetClicked()
    {
        score++;
        MoveTarget();
        await JS.InvokeVoidAsync("playClickSound");
        await JS.InvokeVoidAsync("animateHit");
    }

    private async Task CopyScore()
    {
        string text = $"I scored {score} in Quick Click on MooSharp.dev!";
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        copyMessage = "Copied to clipboard!";
        await InvokeAsync(StateHasChanged);
    }

    private void OnMissClick()
    {
    }
}
