@page "/terminal/projects"
@layout TerminalLayout

<div class="projects-container">
    <h1 class="glitch-header">Projects</h1>
    <p class="projects-intro">
        
    </p>

    <div class="product-grid">
        <div class="product-card">
            <h3>Tinek</h3>
            <p>AI and mathematical algorithm driven hunting app for predictions, data storage, and more. Mobile and web coming for Deer Season 2026.</p>
            <div class="card-buttons">
                <a href="/projects">View Roadmap</a>
            </div>
        </div>

        <div class="product-card">
            <h3>MooCast Scoreboard</h3>
            <p>A growing scoreboard used by streamers for sports coverage.</p>
            <div class="card-buttons">
                <a href="/MooCast">Use Scoreboard</a>
            </div>
        </div>

        <div class="product-card card-games-link">
            <h3>The Moochine Arcade</h3>
            <p>Jump into my indie game prototypes, experiments, and builds.</p>
            <div class="card-buttons">
                <a href="/arcade">Enter Arcade</a>
            </div>
        </div>
    </div>
</div>
